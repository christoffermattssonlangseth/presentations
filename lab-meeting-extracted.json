  {
    "number": 15,
    "title": "Microglia transition from homeostatic to chronically reactive state",
    "content": [
      {
        "type": "text",
        "paragraphs": [
          {
            "text": "Homeostatic microglial genes down \u2192 P2ry12, Siglech, Cx3cr1",
            "level": 0
          },
          {
            "text": "Antigen presentation & IFN-response up \u2192 B2m, H2-D1, Cd9",
            "level": 0
          },
          {
            "text": "Metabolic activation sustained \u2192 Aldoa, Gfap",
            "level": 0
          },
          {
            "text": "Acute ISR genes fade \u2192 Ddit4",
            "level": 0
          }
        ]
      },
      {
        "type": "text",
        "paragraphs": [
          {
            "text": "Inside out model",
            "level": 0
          }
        ]
