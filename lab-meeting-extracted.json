  {
    "number": 41,
    "title": "MANA",
    "content": [
      {
        "type": "text",
        "paragraphs": [
          {
            "text": "It generalizes CellCharter\u2019s neighborhood aggregation by adding distance-aware weighting within hop layers, so nearer cells contribute more than farther cells:",
            "level": 0
          },
          {
            "text": "Create scVI embedding",
            "level": 0
          },
          {
            "text": "Build neighbor graph",
            "level": 0
          },
          {
            "text": "Aggregate neighbors at \u201chop\u201d intervals computing mean embedding",
            "level": 0
          },
          {
            "text": "GMM or other clustering",
            "level": 0
          },
          {
            "text": "Two-level weighting:",
            "level": 0
          },
          {
            "text": "Hop-level decay (hop_decay^h)",
            "level": 0
          },
          {
            "text": "Distance-based kernel within each hop (e.g., gaussian, exponential, inverse)",
            "level": 0
          }
        ]
      }
    ],
    "images": [
      {
