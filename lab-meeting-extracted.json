  {
    "number": 14,
    "title": "Oligodendrocytes display stress response and metabolic adaptation",
    "content": [
      {
        "type": "text",
        "paragraphs": [
          {
            "text": "ISR & glycolytic genes up \u2192 Atf4, Aldoa, Gstp1, Mt2",
            "level": 0
          },
          {
            "text": "Myelin genes down \u2192 Mbp, Mag, Mog, Cldn11",
            "level": 0
          },
          {
            "text": "Acute stress fades \u2192 Ddit4, Sgk1",
            "level": 0
          },
          {
            "text": "Inflammatory tone persists \u2192 Il33, B2m, H2-D1",
            "level": 0
          },
          {
            "text": "Metabolic and redox remodeling \u2192 Qdpr, Car2 up",
            "level": 0
          }
        ]
      },
      {
        "type": "text",
        "paragraphs": [
          {
            "text": "Inside out model",
            "level": 0
          }
        ]
      }
    ],
    "images": [
      {
